{
    "name": "1fi-marketplace-api",
    "version": "1.0.0",
    "description": "1Fi Marketplace - financing-first shopping API",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc && tsc-alias",
        "start": "node dist/server.js",
        "seed": "tsx src/seeds/marketplace.seed.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write ."
    },
    "keywords": [
        "1fi",
        "marketplace",
        "express",
        "typescript",
        "mongodb"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^7.4.0",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.5.2",
        "morgan": "^1.10.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@eslint/js": "^9.7.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/morgan": "^1.9.9",
        "@types/node": "^20.14.11",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^9.7.0",
        "eslint-config-prettier": "^9.1.0",
        "globals": "^15.8.0",
        "prettier": "^3.3.3",
        "tsc-alias": "^1.9.4",
        "tsx": "^4.16.2",
        "typescript": "^5.5.4"
    }
}